{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectators-of-life.invalid/schemas/benchmark.v1.schema.json",
  "title": "Spectators of Life benchmark manifest v1",
  "type": "object",
  "properties": {
    "format": { "const": "spectators-of-life-benchmark" },
    "benchmarkSchemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "simulationVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "seed": { "$ref": "#/$defs/seed" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "learningCondition": { "$ref": "#/$defs/learningCondition" },
    "durationTicks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/metric" }
    },
    "buildRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "performanceEquipment": {
      "oneOf": [
        { "$ref": "#/$defs/equipment" },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "format",
    "benchmarkSchemaVersion",
    "runId",
    "simulationVersion",
    "seed",
    "scenario",
    "learningCondition",
    "durationTicks",
    "metrics",
    "buildRevision",
    "performanceEquipment"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "metrics": {
            "contains": {
              "properties": { "scope": { "const": "performance" } },
              "required": ["scope"]
            }
          }
        }
      },
      "then": { "properties": { "performanceEquipment": { "$ref": "#/$defs/equipment" } } },
      "else": { "properties": { "performanceEquipment": { "type": "null" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.:/_-][a-z0-9]+)*$"
    },
    "seed": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "contentVersion": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "required": ["id", "version", "checksum"],
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "properties": {
        "systemId": { "$ref": "#/$defs/stableId" },
        "periodTicks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "phaseOffsetTicks": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
      },
      "required": ["systemId", "periodTicks", "phaseOffsetTicks"],
      "additionalProperties": false
    },
    "populationEntry": {
      "type": "object",
      "properties": {
        "speciesId": { "$ref": "#/$defs/stableId" },
        "lifeStageId": { "$ref": "#/$defs/stableId" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["speciesId", "lifeStageId", "count"],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "environmentConfig": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "content": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/contentVersion" }
        },
        "cadences": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/cadence" }
        },
        "initialPopulation": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/populationEntry" }
        },
        "fixture": { "$ref": "#/$defs/scenarioFixture" }
      },
      "required": ["id", "version", "environmentConfig", "content", "cadences", "initialPopulation"],
      "additionalProperties": false
    },
    "scenarioFixture": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "entityKind": { "$ref": "#/$defs/stableId" },
        "entityCount": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "required": ["id", "entityKind", "entityCount"],
      "additionalProperties": false
    },
    "learningCondition": {
      "type": "object",
      "properties": {
        "controllerMode": { "enum": ["heuristic", "frozen-network", "online-learning", "weight-transfer"] },
        "weightsInherited": { "type": "boolean" },
        "conditionId": { "$ref": "#/$defs/stableId" },
        "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      },
      "required": ["controllerMode", "weightsInherited", "conditionId", "parameters"],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "metricId": { "$ref": "#/$defs/stableId" },
        "scope": { "enum": ["ecological", "performance"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 96 },
        "window": { "$ref": "#/$defs/window" },
        "denominator": { "type": "string", "minLength": 1, "maxLength": 512 },
        "populationFilter": { "$ref": "#/$defs/populationFilter" }
      },
      "required": ["metricId", "scope", "unit", "window", "denominator", "populationFilter"],
      "allOf": [
        {
          "if": { "properties": { "metricId": { "const": "food.intake-per-1000-animal-ticks" } } },
          "then": {
            "properties": {
              "populationFilter": {
                "properties": {
                  "speciesId": { "$ref": "#/$defs/stableId" },
                  "lifeStageId": { "$ref": "#/$defs/stableId" }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "fromTickExclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "toTickInclusive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["fromTickExclusive", "toTickInclusive"],
      "additionalProperties": false
    },
    "populationFilter": {
      "type": "object",
      "properties": {
        "speciesId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "lifeStageId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] }
      },
      "required": ["speciesId", "lifeStageId"],
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
        "processor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "logicalProcessorCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "memoryBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["platform", "architecture", "processor", "logicalProcessorCount", "memoryBytes"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectators-of-life.invalid/schemas/worker-protocol.v1.schema.json",
  "title": "Spectators of Life Worker Protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/createWorld"
    },
    {
      "$ref": "#/$defs/step"
    },
    {
      "$ref": "#/$defs/worldCommand"
    },
    {
      "$ref": "#/$defs/load"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/advanced"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/saved"
    },
    {
      "$ref": "#/$defs/loaded"
    },
    {
      "$ref": "#/$defs/disposed"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "requestBase": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "type"
      ]
    },
    "responseBase": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "type"
      ]
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^world-[a-zA-Z0-9-]+$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.:/_-][a-z0-9]+)*$"
    },
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "checksum"
      ],
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "properties": {
        "state": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "minItems": 4,
          "maxItems": 4,
          "not": {
            "items": {
              "const": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "draws"
      ],
      "additionalProperties": false
    },
    "randomState": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "xoshiro128**-1.1"
        },
        "derivation": {
          "const": "fnv1a64-xor-splitmix64-v1"
        },
        "streams": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/stableId"
          },
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.:/_-][a-z0-9]+)*$": {
              "$ref": "#/$defs/stream"
            }
          },
          "additionalProperties": false,
          "maxProperties": 256
        }
      },
      "required": [
        "algorithm",
        "derivation",
        "streams"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "systemId": {
          "$ref": "#/$defs/stableId"
        },
        "periodTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nextTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "systemId",
        "periodTicks",
        "nextTick"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "properties": {
        "simulationVersion": {
          "const": "0.2.0"
        },
        "scenarioId": {
          "enum": ["foundation:empty-world", "natural:temperate-valley"]
        },
        "scenarioVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0", "1.10.0", "1.11.0"]
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "config": {
          "type": "object",
          "maxProperties": 0
        },
        "activeModules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          },
          "maxItems": 256
        },
        "rng": {
          "$ref": "#/$defs/randomState"
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          },
          "maxItems": 1024
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "maxItems": 100000
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "simulationVersion",
        "scenarioId",
        "scenarioVersion",
        "seed",
        "tick",
        "config",
        "activeModules",
        "rng",
        "schedules",
        "entities",
        "metrics"
      ],
      "additionalProperties": false
    },
    "save": {
      "type": "object",
      "properties": {
        "format": {
          "const": "spectators-of-life-save"
        },
        "saveSchemaVersion": {
          "const": 1
        },
        "simulationVersion": {
          "enum": ["0.1.0", "0.2.0"]
        },
        "scenarioId": {
          "enum": ["foundation:empty-world", "natural:temperate-valley"]
        },
        "scenarioVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0", "1.10.0", "1.11.0"]
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "config": {
          "type": "object",
          "maxProperties": 0
        },
        "activeModules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          },
          "maxItems": 256
        },
        "rng": {
          "$ref": "#/$defs/randomState"
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          },
          "maxItems": 1024
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "maxItems": 100000
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "format",
        "saveSchemaVersion",
        "simulationVersion",
        "scenarioId",
        "scenarioVersion",
        "seed",
        "tick",
        "config",
        "activeModules",
        "rng",
        "schedules",
        "entities",
        "metrics"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "systemId": {
          "$ref": "#/$defs/stableId"
        },
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 256
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "tick",
        "systemId",
        "eventType",
        "actorIds",
        "data"
      ],
      "additionalProperties": false
    },
    "createWorld": {
      "allOf": [
        {
          "$ref": "#/$defs/requestBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CREATE_WORLD"
            },
            "scenarioId": {
              "enum": ["foundation:empty-world", "natural:temperate-valley"]
            },
            "scenarioVersion": {
              "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0", "1.10.0", "1.11.0"]
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "config": {
              "type": "object",
              "maxProperties": 0
            }
          },
          "required": [
            "scenarioId",
            "scenarioVersion",
            "seed",
            "config"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "step": {
      "allOf": [
        {
          "$ref": "#/$defs/requestBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "STEP"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "worldId",
            "ticks"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "worldCommand": {
      "allOf": [
        {
          "$ref": "#/$defs/requestBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "GET_SNAPSHOT",
                "SAVE",
                "DISPOSE"
              ]
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            }
          },
          "required": [
            "worldId"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "load": {
      "allOf": [
        {
          "$ref": "#/$defs/requestBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "LOAD"
            },
            "save": {
              "$ref": "#/$defs/save"
            }
          },
          "required": [
            "save"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ready": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "READY"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "simulationVersion": {
              "const": "0.2.0"
            },
            "scenarioId": {
              "enum": ["foundation:empty-world", "natural:temperate-valley"]
            },
            "scenarioVersion": {
              "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0", "1.10.0", "1.11.0"]
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "tick": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "worldId",
            "simulationVersion",
            "scenarioId",
            "scenarioVersion",
            "seed",
            "tick"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "advanced": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ADVANCED"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "tickFrom": {
              "type": "integer",
              "minimum": 0
            },
            "tickTo": {
              "type": "integer",
              "minimum": 1
            },
            "completedTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/event"
              },
              "maxItems": 8192
            },
            "eventsOmitted": {
              "type": "integer",
              "minimum": 0
            },
            "diagnostics": {
              "type": "object",
              "properties": {
                "durationMs": {
                  "type": "number",
                  "minimum": 0
                },
                "simulationVersion": {
                  "const": "0.2.0"
                },
                "seed": {
                  "$ref": "#/$defs/seed"
                }
              },
              "required": [
                "durationMs",
                "simulationVersion",
                "seed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "worldId",
            "tickFrom",
            "tickTo",
            "completedTicks",
            "events",
            "eventsOmitted",
            "diagnostics"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "SNAPSHOT"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "snapshot": {
              "$ref": "#/$defs/state"
            },
            "diagnostics": {
              "type": "object",
              "properties": {
                "faulted": {
                  "const": true
                },
                "message": {
                  "type": "string"
                },
                "systemId": {
                  "$ref": "#/$defs/stableId"
                },
                "entityId": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "faulted",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "worldId",
            "snapshot"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "saved": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "SAVED"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "save": {
              "$ref": "#/$defs/save"
            },
            "saveSchemaVersion": {
              "const": 1
            },
            "tick": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "worldId",
            "save",
            "saveSchemaVersion",
            "tick"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "loaded": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "LOADED"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "simulationVersion": {
              "const": "0.2.0"
            },
            "scenarioId": {
              "enum": ["foundation:empty-world", "natural:temperate-valley"]
            },
            "scenarioVersion": {
              "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0", "1.10.0", "1.11.0"]
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "tick": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "worldId",
            "simulationVersion",
            "scenarioId",
            "scenarioVersion",
            "seed",
            "tick"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "disposed": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DISPOSED"
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            }
          },
          "required": [
            "worldId"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "error": {
      "allOf": [
        {
          "$ref": "#/$defs/responseBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ERROR"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "recoverable": {
              "type": "boolean"
            },
            "tick": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "worldId": {
              "$ref": "#/$defs/worldId"
            },
            "systemId": {
              "$ref": "#/$defs/stableId"
            },
            "entityId": {
              "type": "string",
              "maxLength": 128
            },
            "completedTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "lastValidTick": {
              "type": "integer",
              "minimum": 0
            },
            "simulationVersion": {
              "const": "0.2.0"
            },
            "seed": {
              "$ref": "#/$defs/seed"
            }
          },
          "required": [
            "code",
            "message",
            "recoverable",
            "tick"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
